<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Syntax TV, Sistema, Pulizia: other apps' sizes. Never asked at run time; granted once over adb with
         appops set com.gathin.tvhome GET_USAGE_STATS allow. Without it the page says so. -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Needed since Android 10 to read the Wi-Fi network name for the network pill. Never requested at
         runtime: build-and-install grants it with pm grant, so lint's Android 12 "ask for COARSE with
         FINE" rule does not apply here. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"
        tools:ignore="CoarseFineLocation" />
    <!-- Puts the remote's accessibility helpers back after a force stop of this app took them off the enabled
         list (ServiceRepair). Granted with pm grant by build-and-install when a helper is enabled. -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS"
        tools:ignore="ProtectedPermissions" />
    <!-- Tile menu, Disinstalla: the TV's own uninstall confirmation. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- The TV Liberata catalogue (and, in the liberata, the updater) installs an APK with Android's installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The DNS filter starts again after a reboot (HomeRestore's receiver). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- YaOS (Yandex TV OS): HDMI, AV and the tuner all play in com.yandex.tv.live, whose activities require
         this permission (protection level normal, so it is granted at install). Ignored on other TVs. -->
    <uses-permission android:name="yandex.tv.permission.ACCESS_TV_SOURCE" />

    <!-- Android 11+ package visibility: lets the launcher list the TV apps it shows as tiles, and the
         apps that declare a module card (docs/specs/card.md). -->
    <queries>
        <!-- The standard settings handlers, so package visibility doesn't hide them and send the pills to a vendor fallback by mistake. -->
        <intent>
            <action android:name="android.settings.SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.WIFI_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.DISPLAY_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.MANAGE_APPLICATIONS_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="com.gathin.tvhome.category.DOCK_CARD" />
        </intent>
        <!-- stock_home_redirect: HomeKeyService looks up the stock launcher's HOME activity. -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.HOME" />
        </intent>
        <!-- China-market MIUI TV firmware: the Settings and Wi-Fi pills fall back to Xiaomi's settings app.
             Fire TV: the real settings menu lives in the stock launcher (see settings_fallback_components). -->
        <package android:name="com.xiaomi.mitv.settings" />
        <package android:name="com.tcl.settings" />
        <package android:name="com.amazon.tv.launcher" />
        <!-- Coocaa OS sources for the Inputs menu (coocaa_sources); see CoocaaSources. -->
        <provider android:authorities="com.skyworth.tv.provider" />
        <provider android:authorities="com.skyworth.tv.sdk.provider" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/banner"
        android:networkSecurityConfig="@xml/network_security_config"
        android:theme="@style/Theme.TvHome"
        android:allowBackup="false"
        android:localeConfig="@xml/locales_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:clearTaskOnLaunch="true"
            android:configChanges="orientation|screenSize|keyboard|keyboardHidden|uiMode"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Listed in the TV's own app list, so it can be opened from the stock home screen too. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Syntax TV: the launcher's settings app, on the TV's app row like any other app (its own task, so Back
             leaves it to where the remote was). AppAdapter shows it although it is in the launcher's package. -->
        <activity
            android:name=".SyntaxActivity"
            android:exported="true"
            android:label="@string/syntax_name"
            android:icon="@mipmap/ic_launcher"
            android:banner="@drawable/banner"
            android:taskAffinity="com.gathin.tvhome.syntax"
            android:launchMode="singleTask"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SyntaxWallpaperActivity" android:exported="false"
            android:taskAffinity="com.gathin.tvhome.syntax" android:screenOrientation="landscape" />
        <activity android:name=".SyntaxChristmasActivity" android:exported="false"
            android:taskAffinity="com.gathin.tvhome.syntax" android:screenOrientation="landscape" />
        <activity android:name=".SyntaxSourcesActivity" android:exported="false"
            android:taskAffinity="com.gathin.tvhome.syntax" android:screenOrientation="landscape" />
        <activity android:name=".SyntaxScreensaverActivity" android:exported="false"
            android:taskAffinity="com.gathin.tvhome.syntax" android:screenOrientation="landscape" />
        <activity android:name=".SyntaxNewsActivity" android:exported="false"
            android:taskAffinity="com.gathin.tvhome.syntax" android:screenOrientation="landscape" />
        <activity android:name=".SyntaxSystemActivity" android:exported="false"
            android:taskAffinity="com.gathin.tvhome.syntax" android:screenOrientation="landscape" />
        <activity android:name=".SyntaxRecyclingActivity" android:exported="false"
            android:taskAffinity="com.gathin.tvhome.syntax" android:screenOrientation="landscape" />
        <!-- The DNS filter (Sistema, Filtro): a local VPN that carries only DNS. -->
        <service android:name=".DnsVpnService" android:exported="false"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
        <!-- The filter on or off from the PC over adb (set-up scripts). WRITE_SECURE_SETTINGS: only the adb shell has it. -->
        <receiver android:name=".FilterReceiver" android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="com.gathin.tvhome.FILTER" />
            </intent-filter>
        </receiver>
        <activity android:name=".SyntaxCatalogActivity" android:exported="false"
            android:taskAffinity="com.gathin.tvhome.syntax" android:screenOrientation="landscape" />
        <activity android:name=".SyntaxSystemAppsActivity" android:exported="false"
            android:taskAffinity="com.gathin.tvhome.syntax" android:screenOrientation="landscape" />
        <!-- The night update check (Updater; TV Liberata, liberata edition). -->
        <receiver android:name=".Updater$Nightly" android:exported="false" />
        <activity android:name=".SetupActivity" android:exported="false"
            android:taskAffinity="com.gathin.tvhome.syntax" android:screenOrientation="landscape" />
        <!-- The device configuration and the migration from the pre-1.0 app, from the PC over adb (shell only). -->
        <receiver android:name=".DeviceConfig" android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="com.gathin.tvhome.DEVICE_CONFIG" />
            </intent-filter>
        </receiver>
        <receiver android:name=".ImportReceiver" android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="com.gathin.tvhome.IMPORT" />
            </intent-filter>
        </receiver>
        <activity android:name=".SyntaxFilterActivity" android:exported="false"
            android:taskAffinity="com.gathin.tvhome.syntax" android:screenOrientation="landscape" />
        <!-- TV Liberata: Home's service back on after boot or an update of this app (HomeRestore). -->
        <receiver android:name=".HomeRestore" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!-- The installer's answer to an update (Updater; TV Liberata only). -->
        <receiver android:name=".Updater$Result" android:exported="false" />
        <activity android:name=".SyntaxPlaceActivity" android:exported="false"
            android:taskAffinity="com.gathin.tvhome.syntax" android:screenOrientation="landscape" />
        <activity android:name=".SyntaxMarginActivity" android:exported="false"
            android:taskAffinity="com.gathin.tvhome.syntax" android:screenOrientation="landscape" />
        <activity android:name=".SyntaxThemeActivity" android:exported="false"
            android:taskAffinity="com.gathin.tvhome.syntax" android:screenOrientation="landscape" />
        <!-- The theme from the PC over adb (tests and screenshots; shell only). -->
        <receiver android:name=".Theme$Receiver" android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS">
            <intent-filter>
                <action android:name="com.gathin.tvhome.THEME" />
            </intent-filter>
        </receiver>
        <activity android:name=".SyntaxAppsActivity" android:exported="false"
            android:taskAffinity="com.gathin.tvhome.syntax" android:screenOrientation="landscape" />
        <activity android:name=".SyntaxHiddenAppsActivity" android:exported="false"
            android:taskAffinity="com.gathin.tvhome.syntax" android:screenOrientation="landscape" />
        <activity android:name=".SyntaxCleanupActivity" android:exported="false"
            android:taskAffinity="com.gathin.tvhome.syntax" android:screenOrientation="landscape" />
        <activity android:name=".SyntaxServicesActivity" android:exported="false"
            android:taskAffinity="com.gathin.tvhome.syntax" android:screenOrientation="landscape" />
        <!-- The "Preferite" scene full screen (hold OK on it in Syntax TV). Exported only to the adb shell, for tests:
             WRITE_SECURE_SETTINGS, which the shell has and apps don't. -->
        <activity android:name=".FavoritesPreviewActivity" android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            android:taskAffinity="com.gathin.tvhome.syntax" android:screenOrientation="landscape" />

        <activity
            android:name=".LauncherSettingsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape" />
        <!-- The system input switcher (com.android.tv.action.VIEW_INPUTS), which is what the remote's Input
             button becomes through the TV's Live TV app or InputKeyService. Disabled here and switched on by
             MainActivity only while handle_view_inputs is true (config.xml or a theme), for sets whose stock
             launcher was the only handler of the action (Hisense huangshan, Android TV 10): kept off, a TV with
             its own input picker never sees a second candidate and a chooser. -->
        <activity
            android:name=".InputsRequestActivity"
            android:exported="true"
            android:enabled="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.NoDisplay">
            <intent-filter>
                <action android:name="com.android.tv.action.VIEW_INPUTS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <!-- Remote Settings button panel (settings_key_panel); own task so the app behind stays put. -->
        <activity
            android:name=".QuickSettingsActivity"
            android:exported="false"
            android:taskAffinity=""
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:screenOrientation="landscape"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen" />
        <activity
            android:name=".HomeSettingsActivity"
            android:exported="false"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.NoDisplay" />
        <!-- Home button for remotes that send KEYCODE_ALL_APPS (Xiaomi). Opt-in: HOME_KEY_SERVICE=1
             build-and-install.sh; see HomeKeyService. -->
        <service
            android:name=".HomeKeyService"
            android:label="@string/home_key_name"
            android:directBootAware="true"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/home_key_service" />
        </service>

        <!-- The same clock, started by Home itself after home_idle_clock_minutes without input. -->
        <activity
            android:name=".ClockActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- Profile Cucina: the information panel Home turns into when left alone. -->
        <activity
            android:name=".KitchenPanelActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- Syntax TV's "Prova ora" where the TV cannot start its screensaver on request (Fire OS). -->
        <activity
            android:name=".ScenePreviewActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen" />

        <!-- Screensaver: pick it in Settings, or `settings put secure screensaver_components
             com.gathin.tvhome/.ClockDream` over adb. -->
        <service
            android:name=".ClockDream"
            android:label="@string/dream_name"
            android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>

        <!-- tools/theme.sh writes the theme through this where the shell can't reach Android/data;
             see ThemeProvider. WRITE_SECURE_SETTINGS: the adb shell has it, ordinary apps don't. -->
        <provider
            android:name=".ThemeProvider"
            android:authorities="${applicationId}.theme"
            android:exported="true"
            android:permission="android.permission.WRITE_SECURE_SETTINGS" />

        <!-- The remote's Input button (KEYCODE_TV or KEYCODE_TV_INPUT) opens the input switcher, and input_key_keycodes and
         app_keys (config.xml or a theme) bring back other remote buttons; see InputKeyService. -->
        <service
            android:name=".InputKeyService"
            android:exported="false"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/input_key_service" />
        </service>

        <!-- Fire OS only: replaces Amazon's home screen with this one whenever it comes up (Amazon's launcher stays
             enabled). Turned on by launcher/firetv-home.ps1, never together with dumbtv home's Guard. -->
        <service
            android:name=".FireHomeGuard"
            android:exported="false"
            android:label="@string/fire_home_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/fire_home_guard" />
        </service>
    </application>
</manifest>
