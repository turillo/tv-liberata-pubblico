<?xml version="1.0" encoding="utf-8"?>
<!-- Window changes, to see Amazon's home screen come up; keys only to see HOME while Amazon's own screens are open
     on purpose (Le mie app, Cerca app: FireHomeGuard.pass), so HOME still brings TV Liberata. Window content only to read which app is in
     front when the service (re)connects: Amazon's home already on screen sends no new event. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRetrieveInteractiveWindows|flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="true"
    android:notificationTimeout="0"
    android:description="@string/fire_home_description" />
